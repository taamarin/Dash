#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
STOP=10

start_service() {
    # Prefer the distribution-provided service when it exists.
    [ -x /etc/init.d/sing-box ] && return 0
    [ -x /usr/bin/sing-box ] || return 1

    config="$(uci -q get sing-box.main.conffile 2>/dev/null || true)"
    [ -n "$config" ] || config=/etc/sing-box/config.yaml
    [ -s "$config" ] || return 0

    if [ "${SINGBOX_DASH_PREPARED:-0}" != "1" ]; then
        /usr/bin/python3 /usr/bin/singbox-dash/manager.py prepare-boot \
            >/tmp/singbox-dash-prepare-boot.log 2>&1 || {
            logger -t singbox-dash "prepare-boot failed: $(tail -n 1 /tmp/singbox-dash-prepare-boot.log 2>/dev/null)"
            return 1
        }
    fi

    procd_open_instance
    procd_set_param command /usr/bin/sing-box run -c "$config"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file "$config"
    procd_close_instance
}