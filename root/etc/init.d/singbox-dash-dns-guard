#!/bin/sh /etc/rc.common
USE_PROCD=1
START=96
STOP=20

PROG=/usr/bin/singbox-dash/dns-guard.py
PYTHON=/usr/bin/python3

start_service() {
    [ -x "$PROG" ] || return 1
    procd_open_instance
    procd_set_param command "$PYTHON" "$PROG" run
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    [ -x "$PROG" ] && "$PYTHON" "$PROG" recover >/dev/null 2>&1 || true
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger singbox-dash
}
