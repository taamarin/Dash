#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99

start_service() {
    [ -s /etc/sing-box/.dash-state/.dash-active.json ] || return 0
    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/bin/singbox-dash/manager.py worker
    procd_set_param respawn 60 2 3
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
}
