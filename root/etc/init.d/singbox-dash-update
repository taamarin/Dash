#!/bin/sh /etc/rc.common
USE_PROCD=1
START=98

start_service() {
    [ "$(uci -q get singbox-dash.main.update_interval 2>/dev/null || echo 0)" != "0" ] || return 0
    procd_open_instance
    procd_set_param command /bin/sh /usr/bin/singbox-dash/update-loop.sh
    procd_set_param respawn 60 2 3
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
}
